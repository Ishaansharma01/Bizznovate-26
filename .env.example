# ==============================================================================
# SHAILJA YOGA - YOGA TEACHER TRAINING CERTIFICATION (TTC) PLATFORM
# Environment Configuration Template (.env.example)
# DO NOT commit real secrets, private keys, or passwords to version control.
# Copy this file to .env in backend/ or root and fill in your values.
# ==============================================================================

# Application & Environment
APP_ENV=development
DEBUG=True
APP_NAME="Shailja Yoga Hours Verification & Certification Platform"
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:5173

# Authoritative Timezone (Default for Shailja Yoga program operations)
PROGRAM_TIMEZONE=Asia/Kolkata

# Database Configuration
# In production: postgresql://user:password@localhost:5432/shailja_yoga
# In local development: defaults to SQLite if Postgres is unavailable
DATABASE_URL=sqlite:///./shailja_yoga.db

# Authentication & JWT Configuration
JWT_SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Program Default Rules (Configurable per program, defaults below)
DEFAULT_REQUIRED_HOURS=200
DEFAULT_DAILY_MAX_HOURS=8
DEFAULT_BACKDATING_WINDOW_HOURS=48

# Backdating Boundary Policy ("elapsed_hours" vs "calendar_days")
# "elapsed_hours": exact 48.0 hours from practice date/time to submission timestamp
# "calendar_days": within 2 calendar days prior to current date in program timezone
BACKDATING_BOUNDARY_POLICY=elapsed_hours

# Pace Warning Defaults
DEFAULT_PACE_WARNING_SHORTFALL_HOURS=10.0
PACE_CHECK_CRON_SCHEDULE="0 8 * * 1"

# Certificate & Storage Configuration
CERTIFICATE_STORAGE_DIR=backend/storage/certificates
CERTIFICATE_SIGNING_KEY_PATH=backend/keys/certificate_signing_private.pem
CERTIFICATE_SIGNING_PASSPHRASE=replace-with-signing-key-passphrase
PUBLIC_VERIFIER_URL=http://localhost:5173/verify

# NLP Summarization Service
# Options: "mock" (default for offline/local development), "gemini", "openai"
NLP_SERVICE_PROVIDER=mock
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# Notification Provider
# Options: "mock" (prints to log/console), "smtp", "twilio"
NOTIFICATION_PROVIDER=mock
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
NOTIFICATION_FROM_EMAIL=notifications@shailjayoga.com
